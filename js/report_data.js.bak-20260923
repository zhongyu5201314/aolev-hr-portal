  {
    "id": "recvqhc1Z4lfFZ",
    "reporter_name": "李文杰",
    "reporter_id": "ou_1e95a00de102b21f87980ff1c017787a",
    "cycle": "2026年7月第4周（7月21日-7月24日）",
